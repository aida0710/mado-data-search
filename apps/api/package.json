{
  "name": "@mds/api",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "ingest:dev": "tsx --env-file-if-exists=../../.env src/ingestWorker.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --conditions=compiled dist/server.js",
    "start:ingest": "node --conditions=compiled dist/ingestWorker.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clickhouse/client": "^1.12.1",
    "@hono/node-server": "^2.1.3",
    "@mds/contracts": "0.1.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "mysql2": "^3.15.3",
    "openid-client": "^6.8.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
