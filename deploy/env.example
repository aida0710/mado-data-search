# 値はこのファイルに書かず、本番のVMの .env にだけ置く。
MDS_IMAGE=ghcr.io/aida0710/mado-data-search@sha256:...
MDS_PUBLIC_URL=https://mado-data-search.example.internal
MDS_CLICKHOUSE_USER=mado_data_search
MDS_CLICKHOUSE_PASSWORD=
# MySQLの読み取り専用のアカウント。
MDS_MYSQL_HOST=
MDS_MYSQL_PORT=3306
MDS_MYSQL_USER=mado_data_search
MDS_MYSQL_PASSWORD=
MDS_INGEST_INTERVAL_HOURS=24
MDS_INGEST_MAX_MEGABYTES_PER_SECOND=20
MDS_AUTH_MODE=oidc
MDS_SESSION_SECRET=
MDS_OIDC_ISSUER=
MDS_OIDC_CLIENT_ID=
MDS_OIDC_CLIENT_SECRET=
# ログインを許すIdPのグループ。
MDS_OIDC_ALLOWED_GROUP=
