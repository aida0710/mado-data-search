<!-- ほかのサービスと同じVMで小さく動かす設定。メモリの上限はComposeのmem_limitから決まる。ディスクが少ないので、運用の記録の表を作らない。 -->
<clickhouse>
  <mark_cache_size>536870912</mark_cache_size>
  <uncompressed_cache_size>0</uncompressed_cache_size>
  <merge_tree>
    <max_bytes_to_merge_at_max_space_in_pool>32000000000</max_bytes_to_merge_at_max_space_in_pool>
  </merge_tree>
  <query_log remove="1"/>
  <query_thread_log remove="1"/>
  <query_views_log remove="1"/>
  <query_metric_log remove="1"/>
  <part_log remove="1"/>
  <text_log remove="1"/>
  <trace_log remove="1"/>
  <metric_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <latency_log remove="1"/>
  <error_log remove="1"/>
  <processors_profile_log remove="1"/>
  <opentelemetry_span_log remove="1"/>
  <session_log remove="1"/>
  <crash_log remove="1"/>
  <blob_storage_log remove="1"/>
  <background_schedule_pool_log remove="1"/>
</clickhouse>
